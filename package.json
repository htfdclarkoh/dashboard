{
  "name": "htfd-desktop-app",
  "version": "4.1.4",
  "description": "Harmony Township Fire Department station dashboard",
  "main": "main.js",
  "scripts": {
    "assets": "tailwindcss -i styles/tailwind.css -o assets/tailwind.css --minify && node scripts/build-assets.mjs",
    "check": "node scripts/check-project.mjs && node --test tests/*.test.mjs",
    "start": "electron .",
    "build": "pnpm assets && pnpm check && electron-builder --publish always",
    "build:local": "pnpm assets && pnpm check && electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "electron-log": "^5.0.3",
    "electron-updater": "^6.1.7",
    "feather-icons": "^4.29.2",
    "firebase": "^12.17.1",
    "fs-extra": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^39.8.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "615.harmonytownship.dashboard",
    "productName": "HTFD76 DB",
    "files": [
      "main.js",
      "index.html",
      "assets/**/*",
      "sounds/**/*",
      "vendor/**/*",
      "shared/**/*",
      "dayjs.min.js",
      "package.json",
      "!admin.html",
      "!deptadmin/**/*",
      "!appscript.gs",
      "!GHTOKEN.txt",
      "!scripts/**/*",
      "!tests/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "./assets/icon.png",
      "publish": [
        {
          "provider": "github",
          "owner": "htfdclarkoh",
          "repo": "dashboard",
          "releaseType": "release"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    },
    "asar": true
  }
}
